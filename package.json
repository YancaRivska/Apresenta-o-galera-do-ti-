{
	"name": "apresenta-o-galera-do-ti-",
	"version": "1.0.0",
	"description": "⚡ GALERA DO TI",
	"main": "index.js",
	"scripts": {
		"sass:build": "sass src/scss/main.scss dist/css/main.css --style=expanded --no-source-map",
	  "sass:watch": "sass --watch src/scss/main.scss:dist/css/main.css --style=expanded",
	  "serve": "live-server --port=5500 --open=index.html",
	  "dev": "concurrently \"npm run sass:watch\" \"npm run serve\"",
	  "build": "sass src/scss/main.scss dist/css/main.css --style=compressed --no-source-map",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
